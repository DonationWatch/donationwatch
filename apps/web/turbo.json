{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test:i18n": {
      "inputs": ["src/messages/*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

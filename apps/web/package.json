{
  "name": "@donationwatch/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:analyze": "pnpm next experimental-analyze",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && rm -rf .next && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare build && rm -rf .next && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:upload": "opennextjs-cloudflare build && rm -rf .next && opennextjs-cloudflare upload",
    "dev": "next dev --turbo",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbo",
    "dev:turbo": "next dev --turbo",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:i18n": "i18n-check --source en --locales src/messages",
    "test:unit": "vitest run ./tests/",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@donationwatch/core": "workspace:*",
    "@donationwatch/data": "workspace:*",
    "@donationwatch/ui": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "accept-language-parser": "^1.5.0",
    "client-only": "0.0.1",
    "echarts": "catalog:",
    "lucide-react": "catalog:",
    "next": "^16.4.6",
    "next-intl": "catalog:",
    "nuqs": "^2.10.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "file:../../stubs/server-only",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "catalog:",
    "@lingual/i18n-check": "^0.9.5",
    "@marsidev/react-turnstile": "^1.6.3",
    "@opennextjs/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "postcss": "^8.5.33",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-content-visibility": "^1.0.3",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}

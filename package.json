{
  "name": "donationwatch",
  "version": "1.0.0",
  "description": "Political party donation tracker - visualizing political donations across multiple countries",
  "private": true,
  "homepage": "https://donation.watch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonationWatch/donationwatch.git"
  },
  "bugs": {
    "url": "https://github.com/DonationWatch/donationwatch/issues"
  },
  "author": "numdefined",
  "license": "AGPL-3.0",
  "keywords": [
    "political-donations",
    "transparency",
    "open-data",
    "nextjs",
    "visualization"
  ],
  "scripts": {
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "data:fake": "tsx tasks/fake-data/generate-fake-data.ts",
    "data:postprocess": "tsx tasks/load-data/postprocess.ts",
    "data:rebuild": "FETCH_FROM_REMOTE=true tsx tasks/load-data/index.ts",
    "data:rebuild:cached": "FETCH_FROM_REMOTE=false tsx tasks/load-data/index.ts",
    "data:wikipedia": "tsx tasks/wikipedia/populate-wikipedia-articles.ts",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbo",
    "dev:turbo": "next dev --turbo",
    "generate-social-media": "tsx tasks/social-media/generate-social-media-posts.ts",
    "index-now": "tsx tasks/index-now/index-now.ts",
    "lint": "pnpm lint:tasks && pnpm lint:e2e && pnpm lint:next",
    "lint:e2e": "eslint e2e",
    "lint:next": "eslint src",
    "lint:tasks": "eslint tasks",
    "og-images": "vitest run ./tasks/social-images/generate-images.test.tsx",
    "og-images:countries": "tsx tasks/social-images/cli-generate-images.ts",
    "pre-deploy": "pnpm run data:postprocess && rm -rf tasks && env && df -h",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run './tests/'",
    "test:unit:fake": "FAKE=true vitest run './tests/'",
    "test:unit:watch": "vitest",
    "upload:images": "tsx tasks/social-images/upload.ts"
  },
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@10.1.0+sha512.c89847b0667ddab50396bbbd008a2a43cf3b581efd59cf5d9aa8923ea1fb4b8106c041d540d08acb095037594d73ebc51e1ec89ee40c88b30b8a66c0fae0ac1b",
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "accept-language-parser": "^1.5.0",
    "arktype": "^2.1.29",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "echarts": "^6.0.0",
    "lucide-react": "^0.563.0",
    "next": "^15.5.11",
    "next-intl": "^4.8.3",
    "nuqs": "^2.8.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^4.20260131.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@inquirer/prompts": "^8.2.0",
    "@next/bundle-analyzer": "^15.5.11",
    "@next/eslint-plugin-next": "^15.5.11",
    "@opennextjs/cloudflare": "^1.16.2",
    "@playwright/test": "^1.58.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/accept-language-parser": "^1.5.8",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "debug": "^4.4.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "jsdom": "^26.1.0",
    "node-xlsx": "^0.24.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "puppeteer": "^24.36.1",
    "satori": "^0.19.1",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.1.18",
    "tailwindcss-content-visibility": "^1.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "unzipper": "^0.12.3",
    "vercel": "^46.1.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.61.1"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "ignoredBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@tailwindcss/oxide"
    ],
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}

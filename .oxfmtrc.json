{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "ignorePatterns": [
    "src/data",
    "tasks/data/**/*.ts",
    "**/geojson/**/*",
    "cloudflare-env.d.ts"
  ],
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva", "tw"]
  },
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  }
}

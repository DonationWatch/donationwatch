{
  "name": "@donationwatch/data-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:ai-documentation": "tsx src/ai-documentation/index.ts",
    "data:fake": "tsx src/fake-data/generate-fake-data.ts",
    "data:postprocess": "tsx src/load-data/postprocess.ts && pnpm run data:ai-documentation",
    "data:rebuild": "FETCH_FROM_REMOTE=true tsx src/load-data/index.ts",
    "data:rebuild:cached": "FETCH_FROM_REMOTE=false tsx src/load-data/index.ts",
    "data:wikipedia": "tsx src/wikipedia/populate-wikipedia-articles.ts",
    "generate-social-media": "tsx src/social-media/generate-social-media-posts.ts",
    "generate-social-media:uk": "tsx src/social-media/generate-uk-social-media-posts.ts",
    "icons:generate": "tsx src/icons/generate-icons-sprite.ts",
    "index-now": "tsx src/index-now/index-now.ts",
    "interests:report": "tsx src/interests/report-donor-interests.ts",
    "og-images": "vitest run ./src/social-images/generate-images.test.tsx",
    "og-images:countries": "tsx src/social-images/cli-generate-images.ts",
    "test:unit": "vitest run ./tests/",
    "typecheck": "tsc --noEmit",
    "upload:images": "tsx src/social-images/upload.ts",
    "us:discover-pacs": "tsx src/load-data/us/discover-unmapped-pacs.ts"
  },
  "dependencies": {
    "@donationwatch/core": "workspace:*",
    "@donationwatch/data": "workspace:*",
    "@donationwatch/ui": "workspace:*",
    "@inquirer/prompts": "^8.8.1",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "debug": "^4.4.3",
    "lucide-react": "catalog:",
    "next-intl": "catalog:",
    "node-xlsx": "^0.24.0",
    "openapi-types": "^12.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "satori": "^0.63.2",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/debug": "^4.1.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unzipper": "^0.10.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

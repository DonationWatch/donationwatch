{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "donationwatch",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_VERSION": "22"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.25
    },
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [],
  "send_email": [
    {
      "name": "ENTERPRISE_EMAIL",
      "allowed_sender_addresses": ["enterprise@donation.watch"]
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "limits": {
    "cpu_ms": 1000
  },
  "d1_databases": [
    {
      "binding": "DONATION_WATCH_WAITLIST_DB",
      "database_name": "donation-watch-waitlist",
      "database_id": "baa59aa6-f607-4ff1-9533-b6b51c2a37fa"
    }
  ]
}

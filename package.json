{
  "name": "donationwatch",
  "version": "1.0.0",
  "private": true,
  "description": "Political party donation tracker - visualizing political donations across multiple countries",
  "keywords": [
    "nextjs",
    "open-data",
    "political-donations",
    "transparency",
    "visualization"
  ],
  "homepage": "https://donation.watch",
  "bugs": {
    "url": "https://github.com/DonationWatch/donationwatch/issues"
  },
  "license": "AGPL-3.0",
  "author": "numdefined",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DonationWatch/donationwatch.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "cf:build": "pnpm -C apps/web cf:build",
    "cf:deploy": "pnpm -C apps/web cf:deploy",
    "cf:preview": "pnpm -C apps/web cf:preview",
    "cf:typegen": "pnpm -C apps/web cf:typegen",
    "cf:upload": "pnpm -C apps/web cf:upload",
    "data:fake": "pnpm -C packages/data-pipeline data:fake",
    "data:postprocess": "pnpm -C packages/data-pipeline data:postprocess",
    "data:rebuild": "pnpm -C packages/data-pipeline data:rebuild",
    "data:rebuild:cached": "pnpm -C packages/data-pipeline data:rebuild:cached",
    "data:wikipedia": "pnpm -C packages/data-pipeline data:wikipedia",
    "dev": "turbo run dev",
    "dev:debug": "pnpm -C apps/web dev:debug",
    "dev:turbo": "pnpm -C apps/web dev:turbo",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "icons:generate": "turbo run icons:generate",
    "lint": "turbo boundaries && oxlint",
    "pre-deploy": "pnpm run data:postprocess && pnpm run icons:generate && rm -rf packages/data-pipeline apps/web/e2e apps/web/tests packages/*/tests && env && df -h",
    "prepare": "husky",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "test:e2e:ui": "pnpm -C apps/web test:e2e:ui",
    "test:i18n": "turbo run test:i18n",
    "test:unit": "turbo run test:unit",
    "test:unit:fake": "FAKE=true turbo run test:unit",
    "test:unit:watch": "turbo watch test:unit",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">= 26"
  },
  "packageManager": "pnpm@10.1.0+sha512.c89847b0667ddab50396bbbd008a2a43cf3b581efd59cf5d9aa8923ea1fb4b8106c041d540d08acb095037594d73ebc51e1ec89ee40c88b30b8a66c0fae0ac1b",
  "pnpm": {
    "minimumReleaseAge": 10080,
    "ignoredBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}

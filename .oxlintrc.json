{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "nextjs",
    "react",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/data/**/*",
    "**/countries/**/*",
    "**/geojson/**/*",
    "**/.donations-cache/**/*",
    "**/.next/**",
    "stubs/**"
  ],
  "rules": {
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-unexpected-multiline": "error",
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "import/no-duplicates": "error",
    "react/display-name": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-unescaped-entities": "error",
    "react/react-in-jsx-scope": "off",
    "react/incompatible-library": "off",
    "react/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "off",
    "@typescript-eslint/await-thenable": [
      "error",
      { "allowMixedPromiseArrays": true }
    ],
    "@typescript-eslint/ban-ts-comment": "error",
    "@typescript-eslint/consistent-type-imports": "error",
    "@typescript-eslint/no-empty-object-type": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-import-type-side-effects": "error",
    "@typescript-eslint/no-namespace": "error",
    "@typescript-eslint/no-require-imports": "error",
    "@typescript-eslint/no-unnecessary-type-constraint": "error",
    "@typescript-eslint/no-unsafe-function-type": "error",
    "@typescript-eslint/require-array-sort-compare": "off"
  },
  "overrides": [
    {
      "files": [
        "apps/**/*",
        "packages/core/**/*",
        "packages/ui/**/*",
        "packages/data/**/*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@donationwatch/data-pipeline",
                  "@donationwatch/data-pipeline/*",
                  "**/data-pipeline/**"
                ],
                "message": "Do not import @donationwatch/data-pipeline into apps or shared packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@donationwatch/ui",
                  "@donationwatch/ui/*",
                  "@donationwatch/data",
                  "@donationwatch/data/*",
                  "@donationwatch/data-pipeline",
                  "@donationwatch/data-pipeline/*",
                  "@donationwatch/web",
                  "@donationwatch/web/*",
                  "**/data-pipeline/**",
                  "react",
                  "react-dom",
                  "next",
                  "next/*",
                  "next-intl",
                  "next-intl/*"
                ],
                "message": "@donationwatch/core must remain pure and framework-agnostic."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@donationwatch/data",
                  "@donationwatch/data/*",
                  "@donationwatch/data-pipeline",
                  "@donationwatch/data-pipeline/*",
                  "@donationwatch/web",
                  "@donationwatch/web/*",
                  "**/data-pipeline/**",
                  "next",
                  "next/*",
                  "next-intl",
                  "next-intl/*"
                ],
                "message": "@donationwatch/ui must not depend on Next.js, next-intl, data, or data-pipeline."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/data/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@donationwatch/ui",
                  "@donationwatch/ui/*",
                  "@donationwatch/data-pipeline",
                  "@donationwatch/data-pipeline/*",
                  "@donationwatch/web",
                  "@donationwatch/web/*",
                  "**/data-pipeline/**",
                  "react",
                  "react-dom",
                  "next",
                  "next/*"
                ],
                "message": "@donationwatch/data may only depend on @donationwatch/core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/e2e/**/*.spec.ts"],
      "jsPlugins": ["eslint-plugin-playwright"],
      "env": {
        "shared-node-browser": true
      },
      "rules": {
        "no-empty-pattern": "off",
        "playwright/expect-expect": [
          "warn",
          {
            "assertFunctionPatterns": ["^expect", "^check$"]
          }
        ],
        "playwright/missing-playwright-await": "error",
        "playwright/no-focused-test": "error",
        "playwright/no-networkidle": "error",
        "playwright/no-skipped-test": ["error", { "allowConditional": true }],
        "playwright/no-standalone-expect": "error",
        "playwright/no-unsafe-references": "error",
        "playwright/no-unused-locators": "error",
        "playwright/no-useless-await": "warn",
        "playwright/no-wait-for-navigation": "error",
        "playwright/no-wait-for-timeout": "warn",
        "playwright/prefer-web-first-assertions": "error",
        "playwright/valid-describe-callback": "error",
        "playwright/valid-expect": "error",
        "playwright/valid-expect-in-promise": "error",
        "playwright/valid-test-tags": "error",
        "playwright/valid-title": "error"
      }
    }
  ]
}

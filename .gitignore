# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.idea/
*.iml

# Cloudflare
.dev.vars

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.open-next
.wrangler
*.zip

# app specific data which we don't want to ship
/public/*.txt
/public/data
/public/thumbnails
/public/.well-known
/public/schema
/public/sitemap-global.xml
/public/geojson/**
/tasks/load-data/**/.donations-cache/**
/tasks/data/**/donations.ts
/tasks/data/**/*.ts
/src/data/**/*.ts
/tasks/load-data/**/anonymized-donors.json